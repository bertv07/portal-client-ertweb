# ── Obligatorio ──────────────────────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+asyncpg://ertweb_user:ertweb_password@db:5432/ertweb_db
BACKEND_BASE_URL=https://portal.ertweb.com
CORS_ORIGINS=["https://portal.ertweb.com","https://www.portal.ertweb.com"]

# ── Admin inicial ────────────────────────────────────────────────────────
ADMIN_EMAIL=gleybertmartinez0702@gmail.com
ADMIN_NAME=ert
ADMIN_DEFAULT_PASSWORD=change-me

# Cliente y datos de prueba (client@example.com). Dejar en false en producción.
SEED_DEMO_DATA=false
# CLIENT_DEFAULT_PASSWORD=Client123!

# ── n8n ──────────────────────────────────────────────────────────────────
# URL base de n8n (sin slash final) y la clave compartida: n8n la envía en el
# header X-N8N-API-Key, y el portal la envía igual cuando dispara un webhook.
N8N_WEBHOOK_BASE_URL=https://n8n.tudominio.com
N8N_API_KEY=change-me

# Webhooks de WhatsApp que dispara el portal (ver N8N_WHATSAPP.md)
N8N_WA_SEND_PATH=/webhook/whatsapp-send
N8N_WA_SCHEDULE_PATH=/webhook/whatsapp-schedule
N8N_WA_AI_TOGGLE_PATH=/webhook/whatsapp-ai-toggle
APP_TIMEZONE=America/Caracas

# ── Pagos ────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
BINANCE_ID=
BINANCE_EMAIL=
BINANCE_NAME=
